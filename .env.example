# Required: get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional
# TTD_MODEL=llama-3.3-70b-versatile     # any Groq chat model
# TTD_STORAGE_DIR=backend/storage       # where uploads + the SQLite DB live
# TTD_MAX_UPLOAD_MB=50
# TTD_EXEC_TIMEOUT_S=15                 # sandbox wall-clock limit per query
# TTD_MAX_REPAIR_ATTEMPTS=2             # self-correction retries when generated code fails
# TTD_CORS_ORIGINS=http://localhost:5173
